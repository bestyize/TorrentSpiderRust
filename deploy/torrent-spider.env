# TorrentSpider 服务端配置。
#
# systemd EnvironmentFile 格式：每行一个 KEY=VALUE，# 开头是注释，不支持 export 和变量展开。
# 改完执行 `sudo torrent-spider restart` 生效。升级不会覆盖这个文件。

# 监听地址与端口。服务没有鉴权：只给本机的反向代理用时改成 127.0.0.1
HOST=0.0.0.0
PORT=55555

# 出站代理。这些站点多在墙外，大陆 IP 段也要从 GitHub 拉取，直连不通时配上
#TORRENT_PROXY=127.0.0.1:7897

# 部署在 nginx / Caddy 等反向代理后面时必须设 1，否则违禁过滤判不出访客来源。
# 直连部署不要开：开了之后任何人加一行 X-Forwarded-For 就能绕过过滤
TRUST_FORWARDED_FOR=0

# 违禁内容过滤总开关
SENSITIVE_FILTER=1

# 大陆 IP 段来源，默认 17mon/china_ip_list；国内直连 GitHub 不稳时可以换成镜像
#SENSITIVE_IP_LIST_URL=https://raw.githubusercontent.com/17mon/china_ip_list/master/china_ip_list.txt

# 日志级别，看日志用 `torrent-spider logs`
RUST_LOG=info,tower_http=info
